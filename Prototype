#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Employee {
    int id;
    char name[50];
    float basic, hra, da, deductions, netSalary;
};

void calculateSalary(struct Employee *e) {
    e->hra = 0.2 * e->basic;
    e->da = 0.1 * e->basic;
    e->netSalary = e->basic + e->hra + e->da - e->deductions;
}

// Safe integer input
int inputInt(const char *msg) {
    char buffer[100];
    int value;
    printf("%s", msg);
    fgets(buffer, sizeof(buffer), stdin);
    sscanf(buffer, "%d", &value);
    return value;
}

// Safe float input
float inputFloat(const char *msg) {
    char buffer[100];
    float value;
    printf("%s", msg);
    fgets(buffer, sizeof(buffer), stdin);
    sscanf(buffer, "%f", &value);
    return value;
}

// Check duplicate ID
int isDuplicate(int id) {
    FILE *fp = fopen("employee.csv", "r");
    struct Employee e;
    char line[200];

    if (!fp) return 0;

    fgets(line, sizeof(line), fp); // skip header

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {
        if (e.id == id) {
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

// Ensure header exists
void ensureHeader() {
    FILE *fp = fopen("employee.csv", "r");

    if (fp == NULL) {
        fp = fopen("employee.csv", "w");
        fprintf(fp, "ID,Name,Basic,HRA,DA,Deductions,NetSalary\n");
    }

    fclose(fp);
}

void addEmployee() {
    ensureHeader();

    FILE *fp = fopen("employee.csv", "a");
    struct Employee e;

    if (!fp) {
        printf("File error!\n");
        return;
    }

    e.id = inputInt("Enter ID: ");

    if (isDuplicate(e.id)) {
        printf("ID already exists!\n");
        fclose(fp);
        return;
    }

    printf("Enter Name: ");
    fgets(e.name, sizeof(e.name), stdin);
    e.name[strcspn(e.name, "\n")] = 0;

    e.basic = inputFloat("Enter Basic Salary: ");
    e.deductions = inputFloat("Enter Deductions: ");

    if (e.basic < 0 || e.deductions < 0) {
        printf("Invalid input!\n");
        fclose(fp);
        return;
    }

    calculateSalary(&e);

    fprintf(fp, "%d,%s,%.2f,%.2f,%.2f,%.2f,%.2f\n",
            e.id, e.name, e.basic, e.hra,
            e.da, e.deductions, e.netSalary);

    fclose(fp);
    printf("Employee Added Successfully!\n");
}

void displayEmployees() {
    FILE *fp = fopen("employee.csv", "r");
    struct Employee e;
    char line[200];

    if (!fp) {
        printf("No records found!\n");
        return;
    }

    fgets(line, sizeof(line), fp); // skip header

    printf("\n--- Employee Records ---\n");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {

        printf("ID: %d\nName: %s\nNet Salary: %.2f\n\n",
               e.id, e.name, e.netSalary);
    }

    fclose(fp);
}

void searchEmployee() {
    FILE *fp = fopen("employee.csv", "r");
    struct Employee e;
    char line[200];
    int id, found = 0;

    if (!fp) {
        printf("No records found!\n");
        return;
    }

    fgets(line, sizeof(line), fp);

    id = inputInt("Enter ID to search: ");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {

        if (e.id == id) {
            printf("Found: %s | Salary: %.2f\n", e.name, e.netSalary);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Employee not found!\n");

    fclose(fp);
}

void updateEmployee() {
    FILE *fp = fopen("employee.csv", "r");
    FILE *temp = fopen("temp.csv", "w");
    struct Employee e;
    char line[200];
    int id, found = 0;

    if (!fp || !temp) {
        printf("File error!\n");
        return;
    }

    fgets(line, sizeof(line), fp);
    fprintf(temp, "%s", line);

    id = inputInt("Enter ID to update: ");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {

        if (e.id == id) {
            e.basic = inputFloat("Enter new Basic: ");
            e.deductions = inputFloat("Enter new Deductions: ");
            calculateSalary(&e);
            found = 1;
        }

        fprintf(temp, "%d,%s,%.2f,%.2f,%.2f,%.2f,%.2f\n",
                e.id, e.name, e.basic, e.hra,
                e.da, e.deductions, e.netSalary);
    }

    fclose(fp);
    fclose(temp);

    remove("employee.csv");
    rename("temp.csv", "employee.csv");

    printf(found ? "Updated!\n" : "Not found!\n");
}

void deleteEmployee() {
    FILE *fp = fopen("employee.csv", "r");
    FILE *temp = fopen("temp.csv", "w");
    struct Employee e;
    char line[200];
    int id, found = 0;

    if (!fp || !temp) {
        printf("File error!\n");
        return;
    }

    fgets(line, sizeof(line), fp);
    fprintf(temp, "%s", line);

    id = inputInt("Enter ID to delete: ");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {

        if (e.id != id) {
            fprintf(temp, "%d,%s,%.2f,%.2f,%.2f,%.2f,%.2f\n",
                    e.id, e.name, e.basic, e.hra,
                    e.da, e.deductions, e.netSalary);
        } else {
            found = 1;
        }
    }

    fclose(fp);
    fclose(temp);

    remove("employee.csv");
    rename("temp.csv", "employee.csv");

    printf(found ? "Deleted!\n" : "Not found!\n");
}

int main() {
    int choice;
    char buffer[50];

    while (1) {
        printf("\n--- Employee Payroll System ---\n");
        printf("1. Add Employee Data\n2. Display Employee Data\n3. Search Employee Data\n4. Update Employee Data\n5. Delete Employee Data\n6. Exit\n");
        fgets(buffer, sizeof(buffer), stdin);
        sscanf(buffer, "%d", &choice);

        switch (choice) {
            case 1: addEmployee(); break;
            case 2: displayEmployees(); break;
            case 3: searchEmployee(); break;
            case 4: updateEmployee(); break;
            case 5: deleteEmployee(); break;
            case 6: exit(0);
            default: printf("Invalid choice!\n");
        }
    }
}
