#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <conio.h>

struct Employee {
    int id;
    char name[50];
    float basic, hra, da, deductions, netSalary;
};

// ================= HASH =================
unsigned long hashPassword(char *str) {
    unsigned long hash = 5381;
    int c;
    while ((c = *str++))
        hash = ((hash << 5) + hash) + c;
    return hash;
}

// ================= PASSWORD INPUT =================
void inputPassword(char *password) {
    char ch;
    int i = 0;
    while (1) {
        ch = getch();
        if (ch == 13) break;
        else if (ch == 8 && i > 0) {
            i--;
            printf("\b \b");
        } else if (i < 49) {
            password[i++] = ch;
            printf("*");
        }
    }
    password[i] = '\0';
    printf("\n");
}

// ================= SAFE INPUT =================
int inputInt(char *msg) {
    char buf[100];
    int val;
    while (1) {
        printf("%s", msg);
        if (!fgets(buf, sizeof(buf), stdin)) continue;
        if (sscanf(buf, "%d", &val) == 1 && val > 0) return val;
        printf("Invalid input! Try again.\n");
    }
}

float inputFloat(char *msg) {
    char buf[100];
    float val;
    while (1) {
        printf("%s", msg);
        if (!fgets(buf, sizeof(buf), stdin)) continue;
        if (sscanf(buf, "%f", &val) == 1 && val >= 0) return val;
        printf("Invalid input! Try again.\n");
    }
}

// ================= LOGIN FILE INIT =================
void initLoginFile() {
    FILE *fp = fopen("login.csv", "r");
    if (!fp) {
        fp = fopen("login.csv", "w");
        fprintf(fp, "admin,%lu,admin\n", hashPassword("1234"));
    }
    fclose(fp);
}

// ================= CHECK USERNAME =================
int usernameExists(const char *username) {
    FILE *fp = fopen("login.csv", "r");
    char line[150], fuser[50];
    if (!fp) return 0;
    while (fgets(line, sizeof(line), fp)) {
        sscanf(line, "%49[^,]", fuser);
        if (strcmp(username, fuser) == 0) {
            fclose(fp);
            return 1;
        }
    }
    fclose(fp);
    return 0;
}

// ================= SIGNUP =================
void signup() {
    char username[50], password[50], role[10];
    FILE *fp = fopen("login.csv", "a");
    if (!fp) return;

    printf("Enter new username: ");
    fgets(username, sizeof(username), stdin);
    username[strcspn(username, "\n")] = 0;

    if (usernameExists(username)) {
        printf("Username already exists!\n");
        fclose(fp);
        return;
    }

    printf("Enter password: ");
    inputPassword(password);

    printf("Enter role (admin/user): ");
    fgets(role, sizeof(role), stdin);
    role[strcspn(role, "\n")] = 0;

    if (strcmp(role, "admin") != 0 && strcmp(role, "user") != 0) {
        printf("Invalid role! Defaulting to user.\n");
        strcpy(role, "user");
    }

    fprintf(fp, "%s,%lu,%s\n", username, hashPassword(password), role);
    fclose(fp);
    printf("User registered successfully!\n");
}

// ================= LOGIN =================
int login(char *roleOut, char *userOut) {
    FILE *fp = fopen("login.csv", "r");
    if (!fp) return 0;

    char username[50], password[50], fuser[50], frole[10];
    unsigned long fpass;
    char line[150];

    printf("Username: ");
    fgets(username, sizeof(username), stdin);
    username[strcspn(username, "\n")] = 0;

    printf("Password: ");
    inputPassword(password);
    unsigned long h = hashPassword(password);

    while (fgets(line, sizeof(line), fp)) {
        sscanf(line, "%49[^,],%lu,%9[^\n]", fuser, &fpass, frole);
        if (strcmp(username, fuser) == 0 && h == fpass) {
            strcpy(roleOut, frole);
            strcpy(userOut, username);
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

// ================= EMPLOYEE FILE HANDLING =================
void ensureEmployeeFile() {
    FILE *fp = fopen("employee.csv", "r");
    if (!fp) {
        fp = fopen("employee.csv", "w");
        fprintf(fp, "ID,Name,Basic,HRA,DA,Deductions,NetSalary\n");
    }
    fclose(fp);
}

// ================= DUPLICATE CHECK =================
int isDuplicate(int id) {
    FILE *fp = fopen("employee.csv", "r");
    struct Employee e;
    char line[200];
    if (!fp) return 0;
    fgets(line, sizeof(line), fp);
    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {
        if (e.id == id) {
            fclose(fp);
            return 1;
        }
    }
    fclose(fp);
    return 0;
}

// ================= SALARY CALCULATION =================
void calculateSalary(struct Employee *e) {
    e->hra = 0.2 * e->basic;
    e->da = 0.1 * e->basic;
    e->netSalary = e->basic + e->hra + e->da - e->deductions;
}

// ================= EMPLOYEE FUNCTIONS =================
void addEmployee() {
    ensureEmployeeFile();
    FILE *fp = fopen("employee.csv", "a");
    struct Employee e;

    e.id = inputInt("Enter ID: ");
    if (isDuplicate(e.id)) {
        printf("ID already exists!\n");
        fclose(fp);
        return;
    }

    printf("Enter Name: ");
    fgets(e.name, sizeof(e.name), stdin);
    e.name[strcspn(e.name, "\n")] = 0;

    e.basic = inputFloat("Enter Basic: ");
    e.deductions = inputFloat("Enter Deductions: ");
    calculateSalary(&e);

    fprintf(fp, "%d,%s,%.2f,%.2f,%.2f,%.2f,%.2f\n",
            e.id, e.name, e.basic, e.hra, e.da, e.deductions, e.netSalary);
    fclose(fp);
    printf("Employee Added Successfully!\n");
}

void displayEmployees() {
    FILE *fp = fopen("employee.csv", "r");
    struct Employee e;
    char line[200];
    if (!fp) return;

    fgets(line, sizeof(line), fp);
    printf("\n--------------------------------------------------------------------------------\n");
    printf("%-5s %-20s %-10s %-10s %-10s %-12s %-12s\n",
           "ID", "Name", "Basic", "HRA", "DA", "Deduct", "Net");
    printf("--------------------------------------------------------------------------------\n");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {
        printf("%-5d %-20s %-10.2f %-10.2f %-10.2f %-12.2f %-12.2f\n",
               e.id, e.name, e.basic, e.hra, e.da,
               e.deductions, e.netSalary);
    }
    printf("--------------------------------------------------------------------------------\n");
    fclose(fp);
}

void searchEmployee() {
    FILE *fp = fopen("employee.csv", "r");
    struct Employee e;
    char line[200];
    int id, found = 0;
    if (!fp) return;

    fgets(line, sizeof(line), fp);
    id = inputInt("Enter ID to search: ");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {
        if (e.id == id) {
            printf("\nFound: %s | Net Salary: %.2f\n", e.name, e.netSalary);
            found = 1;
            break;
        }
    }

    if (!found) printf("Employee not found!\n");
    fclose(fp);
}

void updateEmployee() {
    FILE *fp = fopen("employee.csv", "r");
    FILE *temp = fopen("temp.csv", "w");
    struct Employee e;
    char line[200];
    int id, found = 0;
    if (!fp || !temp) return;

    fgets(line, sizeof(line), fp);
    fprintf(temp, "%s", line);

    id = inputInt("Enter ID to update: ");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {

        if (e.id == id) {
            e.basic = inputFloat("New Basic: ");
            e.deductions = inputFloat("New Deductions: ");
            calculateSalary(&e);
            found = 1;
        }

        fprintf(temp, "%d,%s,%.2f,%.2f,%.2f,%.2f,%.2f\n",
                e.id, e.name, e.basic, e.hra, e.da, e.deductions, e.netSalary);
    }

    fclose(fp);
    fclose(temp);
    remove("employee.csv");
    rename("temp.csv", "employee.csv");

    printf(found ? "Updated successfully!\n" : "Employee not found!\n");
}

void deleteEmployee() {
    FILE *fp = fopen("employee.csv", "r");
    FILE *temp = fopen("temp.csv", "w");
    struct Employee e;
    char line[200];
    int id, found = 0;
    if (!fp || !temp) return;

    fgets(line, sizeof(line), fp);
    fprintf(temp, "%s", line);

    id = inputInt("Enter ID to delete: ");

    while (fscanf(fp, "%d,%49[^,],%f,%f,%f,%f,%f\n",
                  &e.id, e.name, &e.basic, &e.hra,
                  &e.da, &e.deductions, &e.netSalary) != EOF) {
        if (e.id == id) {
            found = 1;
            continue;
        }
        fprintf(temp, "%d,%s,%.2f,%.2f,%.2f,%.2f,%.2f\n",
                e.id, e.name, e.basic, e.hra, e.da, e.deductions, e.netSalary);
    }

    fclose(fp);
    fclose(temp);
    remove("employee.csv");
    rename("temp.csv", "employee.csv");

    printf(found ? "Deleted successfully!\n" : "Employee not found!\n");
}

int main() {
    char role[10], username[50];
    int choice;
    char buf[50];

    initLoginFile();
    ensureEmployeeFile();

    while (1) {
        printf("\n--- Employee Payroll System ---\n");
        printf("1. Login\n2. Signup\n3. Exit\n");
        printf("Enter choice: ");
        if (!fgets(buf, sizeof(buf), stdin)) continue;
        sscanf(buf, "%d", &choice);

        if (choice == 1) {
            if (login(role, username)) break;
            else printf("Invalid login!\n");
        } else if (choice == 2) signup();
        else exit(0);
    }

    while (1) {
        printf("\n--- MENU (%s) ---\n", role);
        printf("1.Add Employee Data\n2.Display Employee Data\n3.Search Employee Data\n4.Update Employee Data\n5.Delete Employee Data\n6.Exit\n");
        printf("Enter choice: ");
        if (!fgets(buf, sizeof(buf), stdin)) continue;
        sscanf(buf, "%d", &choice);

        switch (choice) {
            case 1:
                if (strcmp(role, "admin") == 0) addEmployee();
                else printf("Access Denied\n");
                break;
            case 2: displayEmployees(); break;
            case 3: searchEmployee(); break;
            case 4:
                if (strcmp(role, "admin") == 0) updateEmployee();
                else printf("Access Denied\n");
                break;
            case 5:
                if (strcmp(role, "admin") == 0) deleteEmployee();
                else printf("Access Denied\n");
                break;
            case 6: exit(0);
            default: printf("Invalid choice\n");
        }
    }
}
