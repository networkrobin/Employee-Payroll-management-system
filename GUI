import tkinter as tk
from tkinter import ttk, messagebox
import ctypes
import os
import sys

# ================= DLL LOADER =================
def resource_path(filename):
    if hasattr(sys, '_MEIPASS'):
        return os.path.join(sys._MEIPASS, filename)
    return os.path.join(os.path.abspath('.'), filename)

DLL_PATH = resource_path('payroll.dll')

try:
    lib = ctypes.CDLL(DLL_PATH)
except:
    lib = None

# ================= MAIN WINDOW =================
root = tk.Tk()
root.title('Employee Payroll System')
root.geometry('1000x650')
root.configure(bg='#f5f5f5')

# ================= VARIABLES =================
username_var = tk.StringVar()
password_var = tk.StringVar()
role_var = tk.StringVar(value='user')

emp_id_var = tk.StringVar()
emp_name_var = tk.StringVar()
basic_var = tk.StringVar()
deduction_var = tk.StringVar()
search_var = tk.StringVar()

# ================= CSV HELPERS =================
def ensure_files():
    if not os.path.exists('employee.csv'):
        with open('employee.csv', 'w') as f:
            f.write('ID,Name,Basic,HRA,DA,Deductions,NetSalary\n')

    if not os.path.exists('login.csv'):
        with open('login.csv', 'w') as f:
            f.write('admin,1234,admin\n')

ensure_files()

# ================= LOGIN =================
def login_user():

    username = username_var.get()
    password = password_var.get()

    found = False

    with open('login.csv', 'r') as f:
        for line in f:
            data = line.strip().split(',')

            if len(data) >= 3:
                u, p, r = data

                if username == u and password == p:
                    found = True
                    login_frame.pack_forget()
                    dashboard_frame.pack(fill='both', expand=True)
                    welcome_label.config(text=f'Welcome {username} ({r})')
                    load_table()
                    break

    if not found:
        messagebox.showerror('Error', 'Invalid Login')

# ================= SIGNUP =================
def signup_user():

    username = username_var.get()
    password = password_var.get()
    role = role_var.get()

    if username == '' or password == '':
        messagebox.showerror('Error', 'Fill all fields')
        return

    with open('login.csv', 'r') as f:
        for line in f:
            if line.startswith(username + ','):
                messagebox.showerror('Error', 'Username exists')
                return

    with open('login.csv', 'a') as f:
        f.write(f'{username},{password},{role}\n')

    messagebox.showinfo('Success', 'Signup Successful')

# ================= ADD EMPLOYEE =================
def add_employee():

    emp_id = emp_id_var.get()
    name = emp_name_var.get()
    basic = basic_var.get()
    deduction = deduction_var.get()

    if not emp_id or not name or not basic:
        messagebox.showerror('Error', 'Fill all fields')
        return

    basic = float(basic)
    deduction = float(deduction)

    hra = basic * 0.2
    da = basic * 0.1
    net = basic + hra + da - deduction

    with open('employee.csv', 'a') as f:
        f.write(f'{emp_id},{name},{basic},{hra},{da},{deduction},{net}\n')

    messagebox.showinfo('Success', 'Employee Added')

    clear_fields()
    load_table()

# ================= DISPLAY TABLE =================
def load_table():

    for row in employee_table.get_children():
        employee_table.delete(row)

    with open('employee.csv', 'r') as f:
        next(f)

        for line in f:
            data = line.strip().split(',')
            employee_table.insert('', 'end', values=data)

# ================= SEARCH =================
def search_employee():

    search_id = search_var.get()

    for row in employee_table.get_children():
        employee_table.delete(row)

    with open('employee.csv', 'r') as f:
        next(f)

        for line in f:
            data = line.strip().split(',')

            if data[0] == search_id:
                employee_table.insert('', 'end', values=data)

# ================= UPDATE =================
def update_employee():

    selected = employee_table.focus()

    if not selected:
        messagebox.showerror('Error', 'Select Employee')
        return

    values = employee_table.item(selected, 'values')
    old_id = values[0]

    rows = []

    with open('employee.csv', 'r') as f:
        rows = f.readlines()

    with open('employee.csv', 'w') as f:

        f.write(rows[0])

        for row in rows[1:]:

            data = row.strip().split(',')

            if data[0] == old_id:

                emp_id = emp_id_var.get()
                name = emp_name_var.get()
                basic = float(basic_var.get())
                deduction = float(deduction_var.get())

                hra = basic * 0.2
                da = basic * 0.1
                net = basic + hra + da - deduction

                f.write(f'{emp_id},{name},{basic},{hra},{da},{deduction},{net}\n')

            else:
                f.write(row)

    messagebox.showinfo('Success', 'Employee Updated')
    load_table()

# ================= DELETE =================
def delete_employee():

    selected = employee_table.focus()

    if not selected:
        messagebox.showerror('Error', 'Select Employee')
        return

    values = employee_table.item(selected, 'values')
    delete_id = values[0]

    rows = []

    with open('employee.csv', 'r') as f:
        rows = f.readlines()

    with open('employee.csv', 'w') as f:

        f.write(rows[0])

        for row in rows[1:]:

            data = row.strip().split(',')

            if data[0] != delete_id:
                f.write(row)

    messagebox.showinfo('Success', 'Employee Deleted')
    load_table()

# ================= CLEAR =================
def clear_fields():
    emp_id_var.set('')
    emp_name_var.set('')
    basic_var.set('')
    deduction_var.set('')

# ================= LOGIN FRAME =================
login_frame = tk.Frame(root, bg='white')
login_frame.pack(fill='both', expand=True)

login_title = tk.Label(
    login_frame,
    text='Employee Payroll System',
    font=('Arial', 24, 'bold'),
    bg='white'
)
login_title.pack(pady=30)

form_frame = tk.Frame(login_frame, bg='white')
form_frame.pack(pady=20)

# Username
username_label = tk.Label(form_frame, text='Username', bg='white', font=('Arial', 12))
username_label.grid(row=0, column=0, padx=10, pady=10)

username_entry = tk.Entry(form_frame, textvariable=username_var, width=30)
