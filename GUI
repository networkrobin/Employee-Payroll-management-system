import tkinter as tk
from tkinter import messagebox, simpledialog
import subprocess
import sys
import os

# ================= PYINSTALLER SAFE PATH =================

def resource_path(relative_path):
    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")

    return os.path.join(base_path, relative_path)

# Path to compiled C executable
C_PROGRAM = resource_path("payroll.exe")

# ================= GLOBAL LOGIN =================

logged_username = ""
logged_password = ""
logged_role = ""

# ================= RUN C PROGRAM =================

def run_c_program(cmd_input):
    try:
        proc = subprocess.Popen(
            [C_PROGRAM],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        output, error = proc.communicate(cmd_input)

        if error:
            return f"ERROR:\n{error}"

        return output

    except FileNotFoundError:
        return "ERROR: payroll.exe not found!"

# ================= LOGIN =================

def login_gui():
    global logged_username, logged_password, logged_role

    username = entry_user.get().strip()
    password = entry_pass.get().strip()

    if not username or not password:
        messagebox.showerror("Error", "Enter username and password")
        return

    # Login + Exit
    cmd_input = f"1\n{username}\n{password}\n6\n"

    output = run_c_program(cmd_input)

    if "Invalid login" in output:
        messagebox.showerror("Login Failed", "Invalid username or password!")
        return

    logged_username = username
    logged_password = password

    if "MENU (admin)" in output:
        logged_role = "admin"
    else:
        logged_role = "user"

    messagebox.showinfo(
        "Success",
        f"Welcome {logged_username} ({logged_role})"
    )

    root.destroy()
    open_main_menu()

# ================= MAIN MENU =================

def open_main_menu():

    menu = tk.Tk()

    menu.title("Employee Payroll System")

    menu.geometry("450x420")

    tk.Label(
        menu,
        text=f"Logged in as: {logged_username} ({logged_role})",
        font=("Arial", 12, "bold")
    ).pack(pady=15)

    # ================= ADD EMPLOYEE =================

    def add_employee_gui():

        if logged_role != "admin":
            messagebox.showwarning(
                "Access Denied",
                "Only admins can add employees."
            )
            return

        emp_id = simpledialog.askinteger(
            "Add Employee",
            "Enter Employee ID:"
        )

        if emp_id is None:
            return

        name = simpledialog.askstring(
            "Add Employee",
            "Enter Employee Name:"
        )

        if not name:
            return

        basic = simpledialog.askfloat(
            "Add Employee",
            "Enter Basic Salary:"
        )

        if basic is None:
            return

        deductions = simpledialog.askfloat(
            "Add Employee",
            "Enter Deductions:"
        )

        if deductions is None:
            return

        cmd_input = (
            f"1\n"
            f"{logged_username}\n"
            f"{logged_password}\n"
            f"1\n"
            f"{emp_id}\n"
            f"{name}\n"
            f"{basic}\n"
            f"{deductions}\n"
            f"6\n"
        )

        output = run_c_program(cmd_input)

        messagebox.showinfo("Result", output)

    # ================= DISPLAY =================

    def display_employees_gui():

        cmd_input = (
            f"1\n"
            f"{logged_username}\n"
            f"{logged_password}\n"
            f"2\n"
            f"6\n"
        )

        output = run_c_program(cmd_input)

        win = tk.Toplevel(menu)

        win.title("Employee Records")

        text = tk.Text(
            win,
            width=120,
            height=35,
            font=("Courier New", 10)
        )

        text.pack()

        text.insert(tk.END, output)

    # ================= SEARCH =================

    def search_employee_gui():

        emp_id = simpledialog.askinteger(
            "Search Employee",
            "Enter Employee ID:"
        )

        if emp_id is None:
            return

        cmd_input = (
            f"1\n"
            f"{logged_username}\n"
            f"{logged_password}\n"
            f"3\n"
            f"{emp_id}\n"
            f"6\n"
        )

        output = run_c_program(cmd_input)

        messagebox.showinfo("Search Result", output)

    # ================= UPDATE =================

    def update_employee_gui():

        if logged_role != "admin":
            messagebox.showwarning(
                "Access Denied",
                "Only admins can update employees."
            )
            return

        emp_id = simpledialog.askinteger(
            "Update Employee",
            "Enter Employee ID:"
        )

        if emp_id is None:
            return

        basic = simpledialog.askfloat(
            "Update Employee",
            "Enter New Basic Salary:"
        )

        if basic is None:
            return

        deductions = simpledialog.askfloat(
            "Update Employee",
            "Enter New Deductions:"
        )

        if deductions is None:
            return

        cmd_input = (
            f"1\n"
            f"{logged_username}\n"
            f"{logged_password}\n"
            f"4\n"
            f"{emp_id}\n"
            f"{basic}\n"
            f"{deductions}\n"
            f"6\n"
        )

        output = run_c_program(cmd_input)

        messagebox.showinfo("Update Result", output)

    # ================= DELETE =================

    def delete_employee_gui():

        if logged_role != "admin":
            messagebox.showwarning(
                "Access Denied",
                "Only admins can delete employees."
            )
            return

        emp_id = simpledialog.askinteger(
            "Delete Employee",
            "Enter Employee ID:"
        )

        if emp_id is None:
            return

        cmd_input = (
            f"1\n"
            f"{logged_username}\n"
            f"{logged_password}\n"
            f"5\n"
            f"{emp_id}\n"
            f"6\n"
        )

        output = run_c_program(cmd_input)

        messagebox.showinfo("Delete Result", output)

    # ================= BUTTONS =================

    tk.Button(
        menu,
        text="Add Employee",
        width=30,
        height=2,
        command=add_employee_gui
    ).pack(pady=5)

    tk.Button(
        menu,
        text="Display Employees",
        width=30,
        height=2,
        command=display_employees_gui
    ).pack(pady=5)

    tk.Button(
        menu,
        text="Search Employee",
        width=30,
        height=2,
        command=search_employee_gui
    ).pack(pady=5)

    tk.Button(
        menu,
        text="Update Employee",
        width=30,
        height=2,
        command=update_employee_gui
    ).pack(pady=5)

    tk.Button(
        menu,
        text="Delete Employee",
        width=30,
        height=2,
        command=delete_employee_gui
    ).pack(pady=5)

    tk.Button(
        menu,
        text="Exit",
        width=30,
        height=2,
        bg="red",
        fg="white",
        command=menu.destroy
    ).pack(pady=20)

    menu.mainloop()

# ================= LOGIN WINDOW =================

root = tk.Tk()

root.title("Employee Payroll Login")

root.geometry("350x220")

tk.Label(
    root,
    text="Employee Payroll System",
    font=("Arial", 14, "bold")
).pack(pady=15)

tk.Label(root, text="Username").pack()

entry_user = tk.Entry(root, width=30)

entry_user.pack(pady=5)

tk.Label(root, text="Password").pack()

entry_pass = tk.Entry(root, show="*", width=30)

entry_pass.pack(pady=5)

tk.Button(
    root,
    text="Login",
    width=20,
    height=2,
    command=login_gui
).pack(pady=20)

root.mainloop()
