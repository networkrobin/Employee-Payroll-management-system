import tkinter as tk
from tkinter import messagebox, simpledialog, ttk
import subprocess

# Path to your compiled C program
C_PROGRAM = "./payroll"  # Use "payroll.exe" on Windows

def run_c_program(cmd_input):
    """
    Run the C program with the provided input string.
    cmd_input: a string simulating user's input sequence with \n
    Returns the output from the C program.
    """
    try:
        proc = subprocess.Popen(
            [C_PROGRAM],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        output, error = proc.communicate(cmd_input)
        if error:
            return f"Error: {error}"
        return output
    except FileNotFoundError:
        return "C program not found. Compile it first!"

# ------------------- GUI Functions -------------------

def login_gui():
    username = entry_user.get()
    password = entry_pass.get()
    # Input sequence: "1" for login, username, password
    cmd_input = f"1\n{username}\n{password}\n"
    output = run_c_program(cmd_input)
    if "Invalid login" in output:
        messagebox.showerror("Login Failed", "Invalid username or password!")
    else:
        # Check role
        role = "admin" if "admin" in output else "user"
        messagebox.showinfo("Login Success", f"Welcome {username} ({role})")
        root.destroy()
        open_main_menu(username, role)

# ------------------- Main Menu -------------------

def open_main_menu(username, role):
    menu = tk.Tk()
    menu.title(f"Employee Payroll System - {username} ({role})")
    menu.geometry("400x300")

    tk.Label(menu, text=f"Logged in as: {username} ({role})", font=("Arial", 12)).pack(pady=10)

    def add_employee_gui():
        if role != "admin":
            messagebox.showwarning("Access Denied", "Only admins can add employees.")
            return
        emp_id = simpledialog.askinteger("Add Employee", "Enter Employee ID:")
        name = simpledialog.askstring("Add Employee", "Enter Name:")
        basic = simpledialog.askfloat("Add Employee", "Enter Basic Salary:")
        deductions = simpledialog.askfloat("Add Employee", "Enter Deductions:")
        # Simulate input sequence for C program
        cmd_input = f"1\n{emp_id}\n{name}\n{basic}\n{deductions}\n6\n"  # "6" to exit from submenu
        output = run_c_program(cmd_input)
        messagebox.showinfo("Add Employee", output)

    def display_employees_gui():
        cmd_input = f"2\n6\n"  # 2: display, 6: exit
        output = run_c_program(cmd_input)
        display_window = tk.Toplevel(menu)
        display_window.title("All Employees")
        text = tk.Text(display_window, width=100, height=30)
        text.pack()
        text.insert(tk.END, output)

    def search_employee_gui():
        emp_id = simpledialog.askinteger("Search Employee", "Enter Employee ID:")
        cmd_input = f"3\n{emp_id}\n6\n"  # 3: search, then exit
        output = run_c_program(cmd_input)
        messagebox.showinfo("Search Employee", output)

    def update_employee_gui():
        if role != "admin":
            messagebox.showwarning("Access Denied", "Only admins can update employees.")
            return
        emp_id = simpledialog.askinteger("Update Employee", "Enter Employee ID:")
        new_basic = simpledialog.askfloat("Update Employee", "Enter New Basic Salary:")
        new_deductions = simpledialog.askfloat("Update Employee", "Enter New Deductions:")
        cmd_input = f"4\n{emp_id}\n{new_basic}\n{new_deductions}\n6\n"  # 4: update
        output = run_c_program(cmd_input)
        messagebox.showinfo("Update Employee", output)

    def delete_employee_gui():
        if role != "admin":
            messagebox.showwarning("Access Denied", "Only admins can delete employees.")
            return
        emp_id = simpledialog.askinteger("Delete Employee", "Enter Employee ID:")
        cmd_input = f"5\n{emp_id}\n6\n"  # 5: delete
        output = run_c_program(cmd_input)
        messagebox.showinfo("Delete Employee", output)

    tk.Button(menu, text="Add Employee", width=25, command=add_employee_gui).pack(pady=5)
    tk.Button(menu, text="Display Employees", width=25, command=display_employees_gui).pack(pady=5)
    tk.Button(menu, text="Search Employee", width=25, command=search_employee_gui).pack(pady=5)
    tk.Button(menu, text="Update Employee", width=25, command=update_employee_gui).pack(pady=5)
    tk.Button(menu, text="Delete Employee", width=25, command=delete_employee_gui).pack(pady=5)
    tk.Button(menu, text="Exit", width=25, command=menu.destroy).pack(pady=20)

    menu.mainloop()

# ------------------- Login GUI -------------------

root = tk.Tk()
root.title("Employee Payroll System Login")
root.geometry("300x180")

tk.Label(root, text="Username").pack(pady=5)
entry_user = tk.Entry(root)
entry_user.pack(pady=5)

tk.Label(root, text="Password").pack(pady=5)
entry_pass = tk.Entry(root, show="*")
entry_pass.pack(pady=5)

tk.Button(root, text="Login", command=login_gui).pack(pady=10)

root.mainloop()
