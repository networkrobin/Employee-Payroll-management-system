password_entry = tk.Entry(form_frame, textvariable=password_var, show='*', width=30)
password_entry.grid(row=1, column=1, padx=10, pady=10)

# Role
role_label = tk.Label(form_frame, text='Role', bg='white', font=('Arial', 12))
role_label.grid(row=2, column=0, padx=10, pady=10)

role_combo = ttk.Combobox(form_frame, textvariable=role_var, values=['admin', 'user'], width=27)
role_combo.grid(row=2, column=1, padx=10, pady=10)

# Buttons
login_button = tk.Button(
    login_frame,
    text='Login',
    width=20,
    bg='#4CAF50',
    fg='white',
    command=login_user
)
login_button.pack(pady=10)

signup_button = tk.Button(
    login_frame,
    text='Signup',
    width=20,
    bg='#2196F3',
    fg='white',
    command=signup_user
)
signup_button.pack(pady=10)

# ================= DASHBOARD =================
dashboard_frame = tk.Frame(root, bg='#f5f5f5')

welcome_label = tk.Label(
    dashboard_frame,
    text='Welcome',
    font=('Arial', 20, 'bold'),
    bg='#f5f5f5'
)
welcome_label.pack(pady=10)

# ================= FORM =================
input_frame = tk.Frame(dashboard_frame, bg='white')
input_frame.pack(fill='x', padx=20, pady=10)

fields = [
    ('Employee ID', emp_id_var),
    ('Employee Name', emp_name_var),
    ('Basic Salary', basic_var),
    ('Deduction', deduction_var)
]

for i, (label_text, variable) in enumerate(fields):

    label = tk.Label(input_frame, text=label_text, bg='white', font=('Arial', 11))
    label.grid(row=i, column=0, padx=10, pady=8, sticky='w')

    entry = tk.Entry(input_frame, textvariable=variable, width=35)
    entry.grid(row=i, column=1, padx=10, pady=8)

# ================= BUTTONS =================
button_frame = tk.Frame(dashboard_frame, bg='#f5f5f5')
button_frame.pack(pady=10)

buttons = [
    ('Add Employee', add_employee, '#4CAF50'),
    ('Update Employee', update_employee, '#FF9800'),
    ('Delete Employee', delete_employee, '#F44336'),
    ('Refresh', load_table, '#2196F3')
]

for text, cmd, color in buttons:

    btn = tk.Button(
        button_frame,
        text=text,
        width=18,
        bg=color,
        fg='white',
        command=cmd
    )

    btn.pack(side='left', padx=10)

# ================= SEARCH =================
search_frame = tk.Frame(dashboard_frame, bg='#f5f5f5')
search_frame.pack(pady=10)

search_label = tk.Label(search_frame, text='Search by ID', bg='#f5f5f5')
search_label.pack(side='left', padx=10)

search_entry = tk.Entry(search_frame, textvariable=search_var)
search_entry.pack(side='left', padx=10)

search_button = tk.Button(
    search_frame,
    text='Search',
    bg='#673AB7',
    fg='white',
    command=search_employee
)
search_button.pack(side='left')

# ================= TABLE =================
columns = (
    'ID',
    'Name',
    'Basic',
    'HRA',
    'DA',
    'Deduction',
    'Net Salary'
)

employee_table = ttk.Treeview(
    dashboard_frame,
    columns=columns,
    show='headings',
    height=15
)

for col in columns:
    employee_table.heading(col, text=col)
    employee_table.column(col, width=120)

employee_table.pack(fill='both', expand=True, padx=20, pady=20)

# ================= ROW SELECT =================
def select_record(event):

    selected = employee_table.focus()

    if not selected:
        return

    values = employee_table.item(selected, 'values')

    emp_id_var.set(values[0])
    emp_name_var.set(values[1])
    basic_var.set(values[2])
    deduction_var.set(values[5])

employee_table.bind('<ButtonRelease-1>', select_record)

# ================= RUN =================
root.mainloop()
